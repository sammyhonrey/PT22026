# MovieMind backend — example environment configuration.
# Copy to .env and adjust for local development. NEVER commit your real .env.

# --- Application -------------------------------------------------------------
# development | test | production
APP_ENV=development
APP_NAME=MovieMind API
API_V1_PREFIX=/api/v1
DEBUG=false

# --- Security ------------------------------------------------------------------
# Generate one locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. The development default below must never reach production.
SECRET_KEY=dev-only-secret-change-me
# Access token lifetime in minutes (1..1440)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh sessions are rotated, server-revocable, and stored in HttpOnly cookies.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Use SameSite=None only for cross-site frontend/API deployments; Secure is
# enforced automatically in production. Keep explicit frontend origins in CORS_ORIGINS.
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=false

# --- Database --------------------------------------------------------------------
# Local PostgreSQL example:
#   postgresql+psycopg://moviemind:moviemind@localhost:5432/moviemind
# Neon example (note sslmode=require):
#   postgresql+psycopg://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/moviemind?sslmode=require
DATABASE_URL=postgresql+psycopg://moviemind:moviemind@localhost:5432/moviemind

# --- CORS ------------------------------------------------------------------------
# Comma-separated, explicit origins of the React frontend. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ML model ------------------------------------------------------------------------
# Directory containing moviemind_ncf.pt, model_config.json, user_mapping.json,
# movie_mapping.json, movies.json. Relative paths resolve against the backend/ dir.
MODEL_ARTIFACT_DIR=artifacts
MODEL_DEVICE=cpu

# Demo MovieLens endpoints (Stage A model validation).
# Keep false (or omit) outside local development — see open decision #13.
ENABLE_DEMO_ENDPOINTS=true

# --- Observability ----------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
