# Multimodal Mental State Analyser — environment template
#
# NOTE: the application does NOT load a `.env` file. This file is documentation:
# export the variables you need in your shell before starting, e.g.
#
#   # PowerShell
#   $env:MMSA_DEVICE = "cpu"; python app.py
#   # bash / zsh
#   MMSA_DEVICE=cpu python app.py
#
# Nothing here is required: the application runs with sensible defaults on CPU
# with no configuration at all.

# Execution device: auto | cpu | cuda | mps
# `auto` detects an accelerator and falls back to CPU. Forcing `cpu` is the safest
# choice for a demonstration, because it makes latency numbers reproducible.
MMSA_DEVICE=auto

# Where Hugging Face caches downloaded weights.
# Leave blank to use the default (~/.cache/huggingface). Keeping weights outside the
# repository is a hard requirement: no model file may ever be committed.
# MMSA_CACHE_DIR=

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
MMSA_LOG_LEVEL=INFO

# Optional dimensional head (arousal / dominance / valence). Adds ~1.2 GB.
# DISABLED by default and left disabled deliberately: the upstream checkpoint
# (audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim) ships a task-specific
# regression head that does not load through AutoModelForAudioClassification, so
# `classifier` and `projector` arrive randomly initialised and the arousal/valence
# values would be noise fed into the stress index. Enable only after fixing that
# loader and re-running the correlation check described in report Section 5.6.
# 1 = enabled, 0 = disabled.
MMSA_DIMENSIONAL=0

# Deterministic seed for any sampling and for fixture generation.
MMSA_SEED=1337

# Path to the fitted six-class acoustic head (scripts/train_acoustic_probe.py).
# Used when present; the published four-class head is the fallback when it is not.
# Set to an empty string to force the fallback deliberately.
MMSA_ACOUSTIC_PROBE=models/acoustic_probe.npz
